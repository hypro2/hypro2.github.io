---
layout: null
sitemap: false
---
[
{% assign indexed = site.posts | where_exp: "p", "p.noindex != true" %}
{% for post in indexed %}{
  "title": {{ post.title | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
  "tags": {{ post.tags | join: " " | jsonify }},
  "body": {{ post.content | strip_html | strip_newlines | truncate: 300 | jsonify }}
}{% unless forloop.last %},{% endunless %}{% endfor %}
]
